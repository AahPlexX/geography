{
  "name": "geography-study-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/fetch-map.mjs",
